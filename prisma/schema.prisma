generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ConsultationType {
  GENERAL
  COMPLIANCE
  DATA_SUBJECT_RIGHTS
  SANCTION_RISK
  CONTRACTS
  INTERNATIONAL_TRANSFER
  INCIDENT_RESPONSE
  AUTHORITY_CRITERIA
}

enum SourceStatus {
  PLANNED
  AVAILABLE
  INDEXED
  DISABLED
}

model Consultation {
  id             String           @id @default(cuid())
  sessionId      String
  type           ConsultationType
  question       String           @db.Text
  answer         Json
  model          String?
  vectorStoreId  String?
  sourceCount    Int              @default(0)
  createdAt      DateTime         @default(now())

  @@index([sessionId, createdAt])
  @@index([type])
}

model SourceDocument {
  id             String       @id @default(cuid())
  title          String
  category       String
  jurisdiction   String       @default("Peru")
  issuer         String?
  publicationDate DateTime?
  sourceUrl      String?
  fileId         String?
  vectorStoreId  String?
  status         SourceStatus @default(PLANNED)
  notes          String?      @db.Text
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([category])
  @@index([status])
  @@index([vectorStoreId])
}
